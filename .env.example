# LLM provider for generation (answers). Default: scaleway (EU-hosted, see the Scaleway block
# below). Alternatives: gemini, mistral, openai, ollama.
LLM_PROVIDER=scaleway
# Embeddings (ingestion + retrieval), chosen separately from the LLM: scaleway (default, needs
# SCW_SECRET_KEY + SCW_EMBED_MODEL) or gemini (needs GOOGLE_API_KEY). Each has its own Chroma
# collections, so build them after switching (ingestion.py --reembed-from <provider> reuses
# existing chunks). LLM_PROVIDER=ollama always embeds locally (privacy mode), whatever is set here.
EMBEDDING_PROVIDER=scaleway

# Who to name as the GDPR controller in the in-app privacy notice. Only needed if you're
# running this as a shared instance for other people (a team, an org, a public URL) — leave
# both unset for solo local use, where the notice explains there's no separate operator.
# PRIVACY_CONTROLLER_NAME=Acme Hospital Physics Dept.
# PRIVACY_CONTROLLER_CONTACT=privacy@acme.example

# Admin protection for mutating backend routes (ingest/document mutations).
# Set a strong token and send it as X-Admin-Token header.
# ADMIN_TOKEN=change-me
# Optional dev-only bypass when ADMIN_TOKEN is not set. Keep false in shared/prod setups.
# ADMIN_AUTH_BYPASS=false
# In-memory per-client rate limits (MVP; not shared across multiple workers/replicas).
# RATE_LIMIT_BACKEND=in_memory  # in_memory | redis
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
# RATE_LIMIT_QUERY_MAX_REQUESTS=60
# RATE_LIMIT_QUERY_WINDOW_SEC=60
# RATE_LIMIT_ADMIN_MAX_REQUESTS=20
# RATE_LIMIT_ADMIN_WINDOW_SEC=60
# Only set this to true if a reverse proxy you control sits in front of this app and
# sets X-Forwarded-For itself. With no such proxy, any client can set that header to
# spoof their rate-limit identity — leave it false (default) in that case.
# TRUST_PROXY_HEADERS=false

# For Gemini (if LLM_PROVIDER=gemini and/or EMBEDDING_PROVIDER=gemini).
# GOOGLE_API_KEY=your_google_api_key

# For Gemini (default LLM)
# Optional: Gemini model (default: gemini-2.5-pro). For free tier use gemini-2.5-flash-lite and GEMINI_MIN_DELAY_SEC.
# GEMINI_MODEL=gemini-2.5-pro
# Optional: delay in seconds before each Gemini LLM call. Leave unset for paid tier (higher rate limits). Set for free tier to avoid 429 (e.g. 5 for flash-lite, 12 for pro).
# GEMINI_MIN_DELAY_SEC=
# Optional: delay in seconds between embedding batches during ingestion. Unset or 0 = no delay (paid tier). Set to 65 for free tier (~100 embedding req/min).
# GEMINI_BATCH_DELAY_SEC=

# Time limits for a single provider call, so a stalled provider fails fast instead of
# holding the request (the OpenAI client alone would wait 600 s and retry twice).
# LLM_REQUEST_TIMEOUT_SEC=60
# LLM_MAX_RETRIES=1
# OLLAMA_REQUEST_TIMEOUT_SEC=300

# Docker only: where the vector index lives on the host (bind-mounted into the backend).
# Default ./.chroma, shared with local runs. On a server, e.g. /srv/radiationsafety/chroma.
# CHROMA_DIR=./.chroma

# Privacy Mode: fully local LLM via Ollama (LLM_PROVIDER=ollama)
# No API keys needed. No data leaves your machine.
# LangSmith tracing and web search are auto-disabled in this mode.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# For Mistral (if LLM_PROVIDER=mistral). Throttle (MISTRAL_MIN_DELAY_SEC) when web search is enabled.
# MISTRAL_API_KEY=your_mistral_api_key

# For OpenAI (if LLM_PROVIDER=openai). Used only for generation; embeddings follow EMBEDDING_PROVIDER.
# OPENAI_API_KEY=your_openai_api_key

# Scaleway Generative APIs (default provider): OpenAI-compatible, hosted in the EU.
# For answers (LLM_PROVIDER=scaleway) and/or embeddings (EMBEDDING_PROVIDER=scaleway).
# Model ids change over time; list the ones your key can use:
#   curl -H "Authorization: Bearer $SCW_SECRET_KEY" https://api.scaleway.ai/v1/models
# SCW_SECRET_KEY=your_scaleway_secret_key
# Default answer model (best measured on the golden set, cheapest; eval/README.md).
SCW_MODEL=gemma-4-26b-a4b-it
# Further models the UI offers and clients may request via model_variant (comma-separated).
SCW_ALLOWED_MODELS=deepseek-v4-flash-0731,qwen3.8-27b
# Optional: project-scoped endpoint, e.g. https://api.scaleway.ai/<project_id>/v1
# SCW_BASE_URL=https://api.scaleway.ai/v1
# Embedding model when EMBEDDING_PROVIDER=scaleway (retrieved best on the golden set).
SCW_EMBED_MODEL=bge-multilingual-gemma2
# Questions get the model's retrieval instruction (documents never do); false turns it off.
# EMBED_QUERY_INSTRUCTION=true
# Chunks retrieved per collection (IAEA and Danish law each) for one question.
# RETRIEVER_K=5

# Eval judge (eval/README.md): use a different model than the one that answers.
# EVAL_GRADER_PROVIDER picks the provider, EVAL_JUDGE_MODEL the model (required for scaleway).
# Check a candidate first: uv run python -m eval.judge_check --judge scaleway:<model-id>
# EVAL_GRADER_PROVIDER=scaleway
# EVAL_JUDGE_MODEL=
# Groundedness votes per question, majority wins (default 3; 1 = single call).
# EVAL_JUDGE_VOTES=3

# Danish source sync (POST /documents/sync-danish): retsinformation.dk Harvest + ELI resolver.
# Optional subscription key for the retsinformation.dk Harvest API (higher rate limits); works unauthenticated without it.
# RETSINFO_API_KEY=your_retsinformation_subscription_key
# Resolver mode: shadow (default; ELI result logged for comparison only, legacy resolver stays active),
# guarded or enforce (ELI resolver result is used when available). See docs/architecture.md#danish-source-sync.
# RETSINFO_RESOLVER_MODE=shadow

# Optional Brave Search fallback when retrieval fails
WEB_SEARCH_ENABLED=false
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key
# When false (default): web search uses full web for RAG context; answer is still verified against trusted sources (IAEA, retsinformation.dk, sst.dk).
# When true: web search is restricted to trusted domains only (same as before).
# WEB_SEARCH_TRUSTED_DOMAINS_ONLY=false
# BRAVE_DEBUG=1 to log Brave search calls to brave_search_debug.log (for diagnosis)

# Optional throttling to avoid LLM rate limits when WEB_SEARCH_ENABLED=true
# Delay (in seconds) before LLM grading/generation/search calls; 0 = no extra delay.
# MISTRAL_MIN_DELAY_SEC=3.0

# LangSmith tracing — off by default (opt in). When enabled, every traced request sends
# the verbatim question and the full generated answer to LangChain, Inc. Also disabled
# automatically for Ollama/privacy-mode requests and for requests using a frontend-supplied
# API key, regardless of this setting.
LANGCHAIN_TRACING_V2=false
# EU data residency is offered at no extra cost on all LangSmith plan tiers — use it unless
# you have a specific reason not to. The US endpoint is the LangSmith default if unset.
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com  # US endpoint (LangSmith default region)
LANGCHAIN_PROJECT=radiation-safety-rag
# LANGCHAIN_API_KEY=your_langsmith_api_key
